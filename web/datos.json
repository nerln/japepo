        ]
      },
      "consecuencia_es": "Los seis destacados quedaron como capitanes de grupos de tres y eligieron a dos compañeros cada uno entre los doce restantes.",
      "consecuencia_gn": "Umi poteĩ ojehechakuaáva opyta capitán-ramo aty mbohapy-mbohapy rehe, ha peteĩteĩ oiporavo mokõi irũ umi pakõi hembýva apytégui.",
      "fuente": "rdn_gala1",
      "momentos": [
        {
          "es": "Levantaron la mini caja misteriosa y encontraron vegetales frescos. Quince minutos para cinco cortes.",
          "gn": "Oipe'a hikuái pe mini káha ñemi ha ojuhu vegetal pyahu. Papo aravo'i po ñeikytĩ apo hag̃ua."
        },
        {
          "es": "Cebolla en pluma, locote rojo en juliana, locote verde en brunoise, tres dientes de ajo laminados y papa en rodajas a la española.",
          "gn": "Sevói pluma-pe, lokóte pytã juliana-pe, lokóte hovyũ brunoise-pe, mbohapy ajo laminado ha papa rodaja-pe española-pe."
        },
        {
          "es": "Los jueces les enseñaron a poner papel húmedo bajo la tabla para que no se mueva.",
          "gn": "Umi juez ohechauka chupekuéra omoĩ hag̃ua kuatia akỹ tabla guýpe ani hag̃ua omýi."
        },
        {
          "es": "Hubo cortes accidentales en las manos y nadie soltó el cuchillo.",
          "gn": "Oĩ oñekytĩva ipópe hese'ỹ ha avave ndopoíri kységui."
        },
        {
          "es": "Todos entregaron a tiempo, entre aplausos.",
          "gn": "Opavave ome'ẽ hi'árape, popyapy apytépe."
        },
        {
          "es": "El jurado premió la prolijidad antes que la cantidad. Joaquín Serrano se llevó el primer puesto.",
          "gn": "Pe jurado ohepyme'ẽ mba'e joja porã, na mba'e hetáva. Joaquín Serrano ogueraha puesto peteĩha."
        }
